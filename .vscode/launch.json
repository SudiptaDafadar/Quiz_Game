{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "⚡ Run OmniQuest Full-Stack (Node server.js + Python)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "PORT": "3000",
        "PYTHON_PORT": "5001"
      }
    },
    {
      "name": "⚡ Run OmniQuest (npm run dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "PORT": "3000",
        "PYTHON_PORT": "5001"
      }
    },
    {
      "name": "🌐 Launch Chrome against localhost:3000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "🐍 Run Python Backend Server (Port 5001)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "args": ["5001"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full-Stack App + Browser",
      "configurations": [
        "⚡ Run OmniQuest Full-Stack (Node server.js + Python)",
        "🌐 Launch Chrome against localhost:3000"
      ]
    }
  ]
}
